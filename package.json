{
    "name": "ua-inspect",
    "version": "1.1.0",
    "description": "Zero-dependency User-Agent parser for TypeScript with Client Hints, browser, OS, device, bot and WebView detection for Node.js and browsers",
    "author": "Chatchawan Koedsawas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/petechatchawan/ua-inspect.git"
    },
    "homepage": "https://petechatchawan.github.io/ua-inspect/",
    "bugs": {
        "url": "https://github.com/petechatchawan/ua-inspect/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "default": "./dist/esm/index.js"
        },
        "./check": {
            "types": "./dist/esm/check.d.ts",
            "import": "./dist/esm/check.js",
            "require": "./dist/cjs/check.js",
            "default": "./dist/esm/check.js"
        },
        "./server": {
            "types": "./dist/esm/server.d.ts",
            "import": "./dist/esm/server.js",
            "require": "./dist/cjs/server.js",
            "default": "./dist/esm/server.js"
        },
        "./browser": {
            "types": "./dist/esm/browser.d.ts",
            "import": "./dist/esm/browser.js",
            "require": "./dist/cjs/browser.js",
            "default": "./dist/esm/browser.js"
        },
        "./labels": {
            "types": "./dist/esm/labels.d.ts",
            "import": "./dist/esm/labels.js",
            "require": "./dist/cjs/labels.js",
            "default": "./dist/esm/labels.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "scripts": {
        "lint": "eslint './src/**/*.ts'",
        "clean": "rm -rf dist",
        "build:esm": "tsc --project tsconfig.build.json",
        "build:cjs": "tsc --project tsconfig.build.cjs.json",
        "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/build/finalize-build.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage test/unit",
        "detection:check": "npm run test:coverage",
        "identity:check": "node scripts/verify/verify-package-identity.mjs",
        "typecheck": "tsc --project tsconfig.test.json",
        "check": "npm run lint && npm run typecheck && npm run detection:check && npm run build && npm run pack:check",
        "pack:check": "node scripts/verify/verify-package.mjs",
        "playground:install": "node scripts/playground/install-playground-package.mjs",
        "playground:boundaries": "node scripts/playground/verify-playground-boundaries.mjs",
        "playground:setup": "npm ci --prefix apps/playground && npm run build && npm run playground:install",
        "playground:dev": "npm run playground:setup && npm run dev --prefix apps/playground",
        "playground:typecheck": "npm run typecheck --prefix apps/playground",
        "playground:test": "npm run test --prefix apps/playground",
        "playground:build": "npm run build --prefix apps/playground",
        "playground:test:e2e": "npm run playground:build && npm run test:e2e --prefix apps/playground",
        "playground:check": "npm run playground:setup && npm run playground:boundaries && npm run playground:typecheck && npm run playground:test && npm run playground:test:e2e",
        "prepack": "npm run check"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "user-agent",
        "useragent",
        "user-agent-parser",
        "useragent-parser",
        "ua",
        "parser",
        "client-hints",
        "user-agent-client-hints",
        "sec-ch-ua",
        "browser-detection",
        "browser-detect",
        "device-detection",
        "os-detection",
        "bot-detection",
        "crawler-detection",
        "webview-detection",
        "in-app-browser",
        "line-liff",
        "pwa-detection",
        "typescript",
        "ua-inspect"
    ],
    "devDependencies": {
        "@types/node": "^18.19.130",
        "@typescript-eslint/eslint-plugin": "^8.7.0",
        "@typescript-eslint/parser": "^8.7.0",
        "@vitest/coverage-v8": "~3.2.4",
        "esbuild": "0.25.8",
        "eslint": "^8.25.0",
        "typescript": "^5.9.3",
        "vite": "^6.4.5",
        "vitest": "~3.2.4"
    }
}
